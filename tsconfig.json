{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["supabase/functions", "node_modules", "dist", ".expo"],
  "include": [
    "App.tsx",
